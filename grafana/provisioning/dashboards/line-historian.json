          },
          "rawSql": "SELECT day,round(historian_ah::numeric,2) AS historian_ah,round(lab_reference_ah,2) AS lab_reference_ah,round(difference_pct::numeric,3) AS difference_pct,coverage FROM hist.v_lab_comparison ORDER BY day",
