  "panels": [
    {
      "id": 1,
      "title": "Rectifier current \u00b7 simulated \u00b7 use Rectifier week link",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian-postgres"
          },
          "rawSql": "SELECT time_bucket('5 minutes',s.ts) AS time,g.tag AS metric,avg(s.value) AS value FROM hist.sample s JOIN hist.signal g USING(signal_id) WHERE g.station_id IS NOT NULL AND $__timeFilter(s.ts) GROUP BY 1,2 ORDER BY 1,2",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "amp"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "SKAB pump current and recorded anomaly \u00b7 use SKAB link",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 14,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian-postgres"
          },
          "rawSql": "SELECT p.ts AS time,p.current_a AS current_a,p.anomaly::int AS anomaly FROM hist.v_skab_scored p WHERE recording_id='valve1_1' AND $__timeFilter(p.ts) ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "amp"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "anomaly"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.drawStyle",
                "value": "bars"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Carrier charge \u00b7 measured / planned \u00b7 simulated",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "historian-postgres"
      },
      "gridPos": {
        "x": 14,
        "y": 10,
        "w": 10,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "historian-postgres"
          },
          "rawSql": "SELECT station,carrier_no,round(ratio::numeric,4) AS ratio,round(measured_ah::numeric,3) AS ah,round(planned_ah::numeric,3) AS planned_ah,started,coverage,fault_expected FROM hist.v_ah_ratio ORDER BY ratio,started LIMIT 100",
          "format": "table",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 8
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
